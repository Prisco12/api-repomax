COMPOSE_PROJECT_NAME=nestjs-api-postgres-prod
DOMAIN=api.example.com
ACME_EMAIL=admin@example.com

NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://app.example.com
FRONTEND_URL=https://app.example.com
TRUST_PROXY=true
LOG_LEVEL=info
LOG_PRETTY=false

METRICS_ENABLED=true
OTEL_ENABLED=true
OTEL_SERVICE_NAME=api-postgres
OTEL_SERVICE_VERSION=0.1.0
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://alloy:4318/v1/traces

JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_FROM=no-reply@example.com
MAIL_SECURE=false
MAIL_USER=replace-me
MAIL_PASSWORD=replace-me

RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
REDIS_PASSWORD=replace-with-a-long-random-redis-password

AUDIT_RETENTION_ENABLED=true
AUDIT_RETENTION_DRY_RUN=true
AUDIT_RETENTION_DAYS=365
AUDIT_CLEANUP_BATCH_SIZE=1000
AUDIT_CLEANUP_MAX_BATCHES=100

POSTGRES_DB=nest_api
POSTGRES_USER=nest_api
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-grafana-password
