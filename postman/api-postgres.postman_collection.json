    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "description": "A senha deve ter de 12 a 128 caracteres e conter minúscula, maiúscula, número e símbolo. Em caso de erro, error.details retorna field, code e message.",
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Capture verification token from Mailpit",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const messages = pm.response.json().messages || [];",
                  "const email = pm.collectionVariables.get('userEmail').toLowerCase();",
                  "const message = messages.find((item) => {",
                  "  const value = JSON.stringify(item).toLowerCase();",
                  "  return value.includes(email) && value.includes('confirme seu e-mail');",
                  "});",
                  "pm.expect(message, 'verification email in Mailpit').to.exist;",
                  "const id = message.ID || message.Id || message.id;",
                  "pm.sendRequest(`${pm.collectionVariables.get('mailpitUrl')}/api/v1/message/${encodeURIComponent(id)}`, (error, response) => {",
                  "  pm.expect(error).to.equal(null);",
                  "  const detail = response.json();",
                  "  const content = [detail.Text, detail.HTML, detail.text, detail.html].filter(Boolean).join('\\n').replaceAll('&amp;', '&');",
                  "  const match = content.match(/[?&]token=([^\\s&\\\"'<>]+)/);",
                  "  pm.expect(match, 'verification token').not.to.equal(null);",
                  "  pm.collectionVariables.set('verificationToken', decodeURIComponent(match[1]));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "description": "Localiza no Mailpit o e-mail de confirmação do userEmail e salva verificationToken automaticamente.",
            "method": "GET",
            "url": "{{mailpitUrl}}/api/v1/messages"
          }
        },
        {
          "name": "Verify email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{verificationToken}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/verify-email"
          }
        },
        {
          "name": "Resend verification",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
