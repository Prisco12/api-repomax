generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id                              String         @id @default(uuid()) @db.Uuid
  email                           String         @unique @db.VarChar(320)
  passwordHash                    String
  isActive                        Boolean        @default(true)
  accountStatus                   AccountStatus  @default(PENDING)
  reviewedAt                      DateTime?
  reviewedById                    String?        @db.Uuid
  authorizationVersion            Int            @default(1)
  emailVerifiedAt                 DateTime?
  emailVerificationTokenHash      String?
  emailVerificationTokenExpiresAt DateTime?
  passwordResetTokenHash          String?
  passwordResetTokenExpiresAt     DateTime?
  createdAt                       DateTime       @default(now())
  updatedAt                       DateTime       @updatedAt
  roles                           UserRole[]
  refreshTokens                   RefreshToken[]

  @@index([accountStatus, createdAt])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(100)
  description String?
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(150)
  description String?
  roles       RolePermission[]
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String   @db.VarChar(100)
  resource   String   @db.VarChar(100)
  resourceId String?  @db.VarChar(100)
  status     String   @db.VarChar(30)
  beforeData Json?
  afterData  Json?
  requestId  String?  @db.VarChar(100)
  ip         String?  @db.VarChar(100)
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model Category {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(150)
  slug        String  @unique @db.VarChar(180)
  description String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)
  parentId    String? @db.Uuid

  parent   Category?         @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[]        @relation("CategoryHierarchy")
  products ProductCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId, isActive, sortOrder])
  @@index([isActive, sortOrder])
}

model Product {
  id               String        @id @default(uuid()) @db.Uuid
  name             String        @db.VarChar(200)
  slug             String        @unique @db.VarChar(220)
  sku              String?       @unique @db.VarChar(100)
  shortDescription String?       @db.VarChar(500)
  description      String?
  status           ProductStatus @default(DRAFT)
  isFeatured       Boolean       @default(false)
  sortOrder        Int           @default(0)
  price            Decimal?      @db.Decimal(12, 2)
  showPrice        Boolean       @default(false)
  specifications   Json?
  publishedAt      DateTime?

  categories ProductCategory[]
  images     ProductImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([createdAt(sort: Desc)], map: "Product_createdAt_desc_idx")
  @@index([status, isFeatured(sort: Desc), sortOrder, createdAt(sort: Desc)], map: "Product_public_catalog_order_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_name_trgm_idx")
  @@index([slug(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_slug_trgm_idx")
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_sku_trgm_idx")
  @@index([shortDescription(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_shortDescription_trgm_idx")
}

model ProductCategory {
  productId  String @db.Uuid
  categoryId String @db.Uuid
  sortOrder  Int    @default(0)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId, sortOrder])
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  objectKey String
  url       String?
  altText   String? @db.VarChar(255)
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)
  productId String  @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}
