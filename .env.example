NODE_ENV=development
PORT=3000
TRUST_PROXY=false
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=debug
LOG_PRETTY=true
METRICS_ENABLED=false
OTEL_ENABLED=false
OTEL_SERVICE_NAME=api-postgres
OTEL_SERVICE_VERSION=0.1.0
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
FRONTEND_URL=http://localhost:5173
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=no-reply@example.com
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
REDIS_URL=redis://redis:6379
AUDIT_RETENTION_ENABLED=true
AUDIT_RETENTION_DRY_RUN=false
AUDIT_RETENTION_DAYS=365
AUDIT_CLEANUP_BATCH_SIZE=1000
AUDIT_CLEANUP_MAX_BATCHES=100
FILE_STORAGE_DRIVER=local
FILE_LOCAL_DIRECTORY=./uploads
FILE_SIGNED_URL_TTL_SECONDS=900
AWS_REGION=sa-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/nest_api?schema=public
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Senha123

